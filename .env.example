# AYUDA System - Environment Configuration
# Copy this to .env and fill in your production values
# NEVER commit .env to git - it's in .gitignore

# ============================================
# FLASK CONFIGURATION
# ============================================
FLASK_ENV=production
FLASK_APP=main.py

# ============================================
# DATABASE (REQUIRED FOR PRODUCTION)
# ============================================
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://postgres:SecurePass123@ayuda-prod-db.xxxxx.rds.amazonaws.com:5432/Ayuda
# For local development (default if not set):
# DATABASE_URL=postgresql://postgres:011523@localhost/Ayuda
DATABASE_URL=

# ============================================
# SECURITY (REQUIRED FOR PRODUCTION)
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be a strong random string, at least 32 characters
SECRET_KEY=

# ============================================
# TIMEZONE
# ============================================
# Default: Asia/Manila (for Philippines)
# Other options: America/New_York, Europe/London, etc.
TIMEZONE=Asia/Manila

# ============================================
# INITIAL CREDENTIALS (dev/testing only)
# ============================================
# For production, set these to strong passwords or remove
# ADMIN_PASSWORD=MabitacMSWD_2025
# SAMPLE_USER_PASSWORD=password123

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ============================================
# AWS CONFIGURATION (if using AWS)
# ============================================
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=ap-southeast-1

# ============================================
# LOGGING
# ============================================
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/ayuda/app.log
